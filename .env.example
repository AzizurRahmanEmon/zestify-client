# Required — base URL of the API (no trailing slash)
# App throws at startup if unset
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Required — tenant slug/ID sent as the x-tenant-id header on every API request
NEXT_PUBLIC_TENANT_ID=default-tenant

# Set to false to skip the OTP step in login/register flows
# Must match the API's OTP_REQUIRED setting
NEXT_PUBLIC_OTP_REQUIRED=false

# Required — public URL this site is hosted at (no trailing slash)
# Used for metadata, Open Graph tags, and canonical/blog post URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000