# =============================================================================
# DEVELOPMENT — copy to .env.local for local work
# =============================================================================

# Required — base URL of the API (no trailing slash)
# App throws at startup if unset
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Required — tenant slug/ID sent as the x-tenant-id header on every API request
NEXT_PUBLIC_TENANT_ID=default-tenant

# Set to false to skip the OTP step in login/register flows
# Must match the API's OTP_REQUIRED setting
NEXT_PUBLIC_OTP_REQUIRED=false

# Required — public URL this site is hosted at (no trailing slash)
# Used for metadata, Open Graph tags, and canonical/blog post URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When true (local dev), full HTTP status and response body may be shown for debugging
NEXT_PUBLIC_SHOW_DETAILED_API_ERRORS=true

# When true (local dev only), show OTP returned by the API on password-reset screens
NEXT_PUBLIC_SHOW_DEV_OTP=true

# =============================================================================
# PRODUCTION — on your live host, use these patterns instead:
#
# NEXT_PUBLIC_API_URL=https://your-api-domain.com/api
# NEXT_PUBLIC_TENANT_ID=your_tenant_id_here
# NEXT_PUBLIC_OTP_REQUIRED=true
# NEXT_PUBLIC_SITE_URL=https://your-client-domain.com
# NEXT_PUBLIC_SHOW_DETAILED_API_ERRORS=false
# NEXT_PUBLIC_SHOW_DEV_OTP=false
# =============================================================================
