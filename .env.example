# Required — API base URL (no trailing slash). App fails at startup if unset.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Required — tenant slug or ID sent as x-tenant-id on every API request
NEXT_PUBLIC_TENANT_ID=default-tenant

# Set to false to skip OTP step in login/register flows (must match API OTP_REQUIRED)
NEXT_PUBLIC_OTP_REQUIRED=false
